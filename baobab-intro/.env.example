# Frontend LE BAOBAB — copier ce fichier en .env.local pour le développement local.
# Sur Vercel : Settings → Environment Variables (puis redéployer : la valeur est lue au build).

# Adresse publique de l'API, /api/v1 compris, SANS barre finale.
# Le site doit passer par le routeur Cloudflare (le backend refuse les accès directs).
NEXT_PUBLIC_API_BASE_URL=https://baobab-router.pages.dev/api/v1

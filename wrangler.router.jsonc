// Worker routeur - plan Cloudflare GRATUIT. Deploiement : npx wrangler deploy -c wrangler.router.jsonc
// Sans domaine : l'adresse gratuite https://baobab-router.<votre-compte>.workers.dev est utilisee (workers_dev: true).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baobab-router",
  "main": "workers/router/src/index.ts",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "observability": { "enabled": true },

  // Si vous possedez un domaine dont le DNS est sur Cloudflare (gratuit), decommentez :
  // "routes": [{ "pattern": "baobab.example.com", "custom_domain": true }],

  "vars": {
    "ORIGIN_URL": "https://baobab-api.onrender.com",
    "FRONTEND_ORIGIN": "https://le-baobab.vercel.app",
    "PUBLIC_HOST": "baobab-router.VOTRE-COMPTE.workers.dev"
  }
  // Secret (jamais ici) : EDGE_SHARED_SECRET  (npx wrangler secret put EDGE_SHARED_SECRET -c wrangler.router.jsonc)
}

# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- PostgreSQL (Supabase = Postgres manage ; utiliser le pooler "session" 5432 pour Django) ----
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Connexion DIRECTE (ou pooler session) utilisee uniquement par `migrate` en CI
DATABASE_URL_MIGRATIONS=
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=true
# Informatif (non requis par Django, Supabase reste un simple Postgres)
SUPABASE_PROJECT_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- MongoDB ----
MONGODB_URL=mongodb+srv://user:password@cluster/?retryWrites=true&w=majority
MONGODB_DATABASE=baobab

# ---- Redis (db0 cache, db1 channel layer, db2 queues/locks) ----
REDIS_URL=redis://localhost:6379/0
# Laisser VIDE pour utiliser un channel layer en memoire (une seule instance, offre gratuite).
CHANNEL_REDIS_URL=redis://localhost:6379/1

# ---- JWT ----
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=14

# ---- Jobs planifies (cron Cloudflare -> /internal/jobs/*) : secret partage, >= 32 caracteres (python -c "import secrets;print(secrets.token_hex(32))") ----
INTERNAL_JOB_SECRET=

# ---- Edge : secret partage avec le Worker routeur (refuse tout acces direct a l'origine). Vide = desactive.
EDGE_SHARED_SECRET=
# ---- Planificateur interne (remplace le cron) : a activer sur le SEUL service web
ENABLE_IN_PROCESS_SCHEDULER=false

# ---- Chiffrement des tokens OAuth tiers (cle Fernet : python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())") ----
FIELD_ENCRYPTION_KEY=

# ---- Observabilite ----
LOG_LEVEL=INFO
LOG_JSON=true

# ---- Commerce : commission plateforme (points de base, 1000 = 10 %) et delai d'expiration des commandes impayees
PLATFORM_FEE_BPS=1000
PENDING_ORDER_TTL_HOURS=24
# ---- Secrets de signature des webhooks de paiement, un par fournisseur. VIDE = tous les webhooks de ce fournisseur sont REFUSES (jamais de non-signe).
PAYMENT_WEBHOOK_SECRET_MOBILE_MONEY=
PAYMENT_WEBHOOK_SECRET_CARD=
PAYMENT_WEBHOOK_SECRET_MANUAL=

# ======================= API : SMTP, OTP, STOCKAGE (voir docs et A_NE_PAS_OUBLIER.md) =======================
# ---- SMTP (envoi des codes OTP). Sans EMAIL_HOST, l'envoi echoue proprement et le code est renvoye a l'ecran si OTP_DEBUG_ECHO=true.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=LE BAOBAB <no-reply@votre-domaine.com>
OTP_EMAIL_DAILY_LIMIT=25
# ---- INTERRUPTEURS DE TEST : TOUS A false EN PRODUCTION ----
OTP_DEBUG_ECHO=false
PAYMENTS_SIMULATION_ENABLED=false
STORAGE_FAKE_AUTO_COMPLETE=false
# ---- Stockage de fichiers : bucket S3-compatible (Cloudflare R2, Supabase Storage...). Les fichiers ne passent JAMAIS par l'API.
STORAGE_BACKEND=s3
STORAGE_ENDPOINT_URL=https://<id-du-compte>.r2.cloudflarestorage.com
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
USER_STORAGE_QUOTA_BYTES=524288000
JWT_ACCESS_LIFETIME_MINUTES=15
